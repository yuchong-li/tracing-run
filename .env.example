# Copy to .env and fill in. .env is gitignored.
# Used by docker-compose.yml — these vars become container env at runtime.

# ── App login (REQUIRED — compose refuses to start without it) ───────────────
# Password for /lock screen. Set anything; users cache via 30-day cookie.
LOGIN_PASSWORD=changeme

# ── Display / instance identity ──────────────────────────────────────────────
# Used in container_name (tracing-run-${DISPLAY_NAME}) and DATA_DIR mount path
# (./data/${DISPLAY_NAME}). For multiple instances on one host, give each a
# unique value.
DISPLAY_NAME=runner

# ── Networking ───────────────────────────────────────────────────────────────
# Host port mapped to the container's 8507 internal port.
HOST_PORT=8507

# ── LLM provider (any OpenAI-compatible endpoint) ────────────────────────────
# Examples:
#   OpenAI direct:  https://api.openai.com/v1
#   Local LiteLLM:  http://host.docker.internal:4000/v1
#   OpenRouter:     https://openrouter.ai/api/v1
LLM_BASE=https://api.openai.com/v1
LLM_API_KEY=
DEFAULT_MODEL=gpt-4o

# ── Web search (Tavily — optional) ────────────────────────────────────────────
# Enables the AI coach to autonomously search the live web for training
# methodology, normative comparisons, gear, etc. Sign up at https://tavily.com
# — free tier is 1000 searches/month. Leave blank to disable web search;
# the coach will just say it can't search.
TAVILY_API_KEY=

# ── Timezone ─────────────────────────────────────────────────────────────────
# Sets the container's wall clock. Used by the sidebar greeting, the AI
# coach's "current time" awareness in chat, and every other time-of-day
# feature. Pick your IANA zone — see
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples:
#   Australia/Melbourne   Asia/Shanghai          America/Los_Angeles
#   Europe/London         America/New_York       Asia/Tokyo
# If you leave this commented out, docker-compose.yml falls back to
# Australia/Melbourne.
TZ=Australia/Melbourne
