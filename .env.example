# Copy to .env and fill in. .env is gitignored.
# Used by docker-compose.yml — these vars become container env at runtime.

# ── App login (REQUIRED — compose refuses to start without it) ───────────────
# Password for /lock screen. Set anything; users cache via 30-day cookie.
LOGIN_PASSWORD=changeme

# ── Display / instance identity ──────────────────────────────────────────────
# Used in container_name (tracing-run-${DISPLAY_NAME}) and DATA_DIR mount path
# (./data/${DISPLAY_NAME}). For multiple instances on one host, give each a
# unique value.
DISPLAY_NAME=runner

# ── Networking ───────────────────────────────────────────────────────────────
# Host port mapped to the container's 8507 internal port.
HOST_PORT=8507

# ── LLM provider (any OpenAI-compatible endpoint) ────────────────────────────
# Examples:
#   OpenAI direct:  https://api.openai.com/v1
#   Local LiteLLM:  http://host.docker.internal:4000/v1
#   OpenRouter:     https://openrouter.ai/api/v1
LLM_BASE=https://api.openai.com/v1
LLM_API_KEY=
DEFAULT_MODEL=gpt-4o

# ── Misc ─────────────────────────────────────────────────────────────────────
TZ=UTC
